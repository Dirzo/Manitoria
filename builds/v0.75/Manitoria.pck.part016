j2‘o4¾ÂûœäÌï›ß¬§ŸdÒ§è=ªÉ¥çd7ë£b:ò£‹‹Ð–ªf¤8³¿HaÍ¨u¢d#¨7)EÏéëâ°n“sî.ßŽ"ßp¹[cÉl>ÎB=Ü“žK·ø}_}ã&ç¹ŽQw: •þ	¦q½¾6¯¯cbð§­÷@cä‡ñÌ“Öô*¦þß!xj¼oqòï©®jïš2uâ?4/Þ³ŠoÄ}Švéuö¿DÃ[ƒï­X19^|ãñÿZ¬Óïà¨ NÛPþ¨¾,rGü§ã|Ü¨ž#Ý±u%ó*ìºæ0ŽŽµ—Yä	ýäÕî÷ÒàÉ¶Ä´Ñ™›æ°Î?UŠ:Ø óZwÏ­yÃ¸™5ÍVå¸¨í␀Œü£n÷Gð¸Ð¼1Ù¤Pžƒ‘ÕÑ¿¼_q™ï%aÓ~¢Ý58c*3À=ÿñ`¼XÎnÏqÂå>¹ùŸÐcƒì˜ZÈ—‘Þ6ô.L\cZ'û’>‹ù_¦î”~:b“€7öiºì|üO¢¿ÎùwÀé[ø/Ù†Ëd÷jè5}#æ®’“µo,:éÛ?„÷à¾\4±ÙÑ£ûák´ºhö›NŸi¶Žë8XŸv=c™>ÅqŸóbŸèŸ}lÂ‡8…y´ØÛ8'.Jêó­OƒAÁ[	ž)[ÿcþˆ:4åïcs©µ"thö,ômòrv%ùŽ>}¸V9MLÿ_rRH¸ÿº¶"ú Ð½²°èìlé¡ø&±õín*ô€¾ñzAê1Åbâ÷tjÁX/¿Ísò}5Æ_"™Õ¡é~zÙÿ~ÍÏ-¿Ëò+‹›ùÉ]_c¥ßlO›ÊËœ}~ÍŸYæáeð¿:ègÿi?&Œ|#ÿøŽ‹m5+¦´è°KHAÄü␀␀␀␀␀␀␀␀␀␀␀␀// Channelled lance / light pillar: cylinder along local Y. Soft core, scrolling energy, optional top fade.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 0.8;
uniform vec4 tint : source_color = vec4(1.0,0.85,0.4,1.0);
uniform float intensity = 1.1;
uniform float seed = 0.0;
uniform float span = 1.0;
uniform float pillar = 0.0; // 1 = fade towards +Y end (healing columns)
varying float along;
void vertex(){ along = VERTEX.y/max(span,0.001) + 0.5; }
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float facing = clamp(dot(NORMAL, VIEW), 0.0, 1.0);
	float core = pow(facing, 4.0);
	float soft = pow(facing, 1.2);
	float n = vfx_fbm(vec2(UV.x*6.0, along*8.0*span*0.25 - age*9.0) + seed);
	float grow = smoothstep(along-0.08, along, t*5.0);
	float alive = smoothstep(0.0, 0.06, t) * (1.0 - smoothstep(0.6, 1.0, t));
	float top = mix(1.0, (1.0 - smoothstep(0.15, 1.0, along)) * smoothstep(0.0, 0.08, along), pillar);
	vec3 col = mix(tint.rgb, vec3(1.0), core*0.35);
	float pulse = 0.6 + 0.4*sin(along*span*3.0 - age*22.0);
	ALBEDO = col*intensity*(0.55+0.8*n)*pulse;
	ALPHA = clamp((soft*0.35 + core*0.45)*(0.55+0.6*n)*grow*alive*top, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀// Lightning ribbon: bright white core, tinted halo, flicker. UV.x across, UV.y along.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 0.4;
uniform vec4 tint : source_color = vec4(0.5,0.75,1.0,1.0);
uniform float intensity = 3.0;
uniform float seed = 0.0;
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float x = abs(UV.x*2.0-1.0);
	float core = 1.0 - smoothstep(0.05, 0.22, x);
	float halo = pow(1.0 - x, 2.5);
	float flick = step(0.35, vfx_hash(vec2(floor(age*38.0), seed)));
	flick = mix(1.0, 0.35 + 0.65*flick, step(0.12, t));
	float reveal = smoothstep(UV.y - 0.05, UV.y, t*6.0);   // strike travels down fast
	float fade = 1.0 - smoothstep(0.45, 1.0, t);
	vec3 col = mix(tint.rgb, vec3(1.0), core);
	ALBEDO = col*intensity;
	ALPHA = clamp((core + halo*0.7) * flick * fade * reveal, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀// Shared noise helpers for Manitoria VFX.
float vfx_hash(vec2 p){ p = fract(p*vec2(123.34, 456.21)); p += dot(p, p+45.32); return fract(p.x*p.y); }
float vfx_noise(vec2 p){
	vec2 i = floor(p); vec2 f = fract(p);
	float a = vfx_hash(i), b = vfx_hash(i+vec2(1,0)), c = vfx_hash(i+vec2(0,1)), d = vfx_hash(i+vec2(1,1));
	vec2 u = f*f*(3.0-2.0*f);
	return mix(mix(a,b,u.x), mix(c,d,u.x), u.y);
}
float vfx_fbm(vec2 p){
	float v = 0.0; float a = 0.5;
	for(int i=0;i<5;i++){ v += a*vfx_noise(p); p = p*2.03 + vec2(1.7, 9.2); a *= 0.5; }
	return v;
}
vec2 vfx_voronoi(vec2 p){
	vec2 n = floor(p); vec2 f = fract(p); float d1 = 8.0; float d2 = 8.0;
	for(int j=-1;j<=1;j++) for(int i=-1;i<=1;i++){
		vec2 g = vec2(float(i),float(j));
		vec2 o = vec2(vfx_hash(n+g), vfx_hash(n+g+19.19));
		float d = length(g+o-f);
		if(d<d1){ d2=d1; d1=d; } else if(d<d2){ d2=d; }
	}
	return vec2(d1, d2);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀// Ice / arcane crystal: glossy tinted body with strong fresnel and an inner sparkle. Grows from the ground.
shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, specular_schlick_ggx;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.6;
uniform vec4 tint : source_color = vec4(0.6,0.85,1.0,1.0);
uniform float grow_time = 0.18;
void vertex(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float g = smoothstep(0.0, grow_time, t) * (1.0 - smoothstep(0.82, 1.0, t)*0.9);
	VERTEX *= vec3(mix(0.4,1.0,g), g, mix(0.4,1.0,g));
}
void fragment(){
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW),0.0,1.0), 3.0);
	float spark = step(0.97, vfx_noise(UV*60.0 + age*2.0));
	ALBEDO = tint.rgb*0.55;
	ROUGHNESS = 0.08; METALLIC = 0.1; SPECULAR = 0.9;
	EMISSION = tint.rgb*(0.25 + fres*1.6) + vec3(spark*2.0);
	ALPHA = 0.82 + fres*0.18;
}
␀␀␀// Billboard flame tongue: scrolling fbm shaped into a teardrop, hot core to tinted rim.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.0;
uniform float seed = 0.0;
uniform vec4 tint : source_color = vec4(1.0, 0.45, 0.1, 1.0);
uniform vec4 core : source_color = vec4(1.0, 0.95, 0.7, 1.0);
uniform float intensity = 1.05;
uniform float fade_in = 0.12;
void vertex(){
	// Camera-facing around the Y axis so tongues stay upright.
	vec3 world_pos = MODEL_MATRIX[3].xyz;
	vec3 to_cam = normalize(CAMERA_POSITION_WORLD - world_pos);
	vec3 right = normalize(cross(vec3(0,1,0), to_cam));
	float sx = length(MODEL_MATRIX[0].xyz); float sy = length(MODEL_MATRIX[1].xyz);
	vec3 p = world_pos + right*VERTEX.x*sx + vec3(0,1,0)*VERTEX.y*sy;
	POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(p, 1.0);
}
void fragment(){
	float t = clamp(age/max(life,0.001), 0.0, 1.0);
	vec2 uv = UV; uv.y = 1.0 - uv.y;        // 0 bottom, 1 top
	float time = age*1.7 + seed*13.0;
	float n = vfx_fbm(vec2(uv.x*3.0 + seed*7.0, uv.y*2.2 - time*2.6));
	float n2 = vfx_fbm(vec2(uv.x*6.0 - seed*3.0, uv.y*4.0 - time*4.1));
	float x = (uv.x - 0.5) * 2.0;
	float width = mix(0.95, 0.12, pow(uv.y, 0.8));
	float body = 1.0 - smoothstep(width*0.55, width, abs(x + (n-0.5)*0.55*uv.y));
	float h = uv.y + (n2 - 0.5)*0.35;
	float shape = body * (1.0 - smoothstep(0.55, 1.0, h)) * smoothstep(0.0, 0.12, uv.y);
	float heat = shape * (0.3 + 0.8*n) * (1.0 - 0.35*uv.y);
	float alive = smoothstep(0.0, fade_in, t) * (1.0 - smoothstep(0.55, 1.0, t));
	vec3 deep = tint.rgb*vec3(0.9,0.35,0.25);
	vec3 col = mix(deep, tint.rgb, smoothstep(0.1, 0.45, heat));
	col = mix(col, core.rgb, smoothstep(0.62, 0.95, heat)*smoothstep(0.55,0.2,uv.y));
	ALBEDO = col * intensity;
	ALPHA = clamp(smoothstep(0.08,0.5,heat) * alive, 0.0, 1.0);
}
␀␀␀// Ability footprint telegraph on the ground. mode 0 = circle area, 1 = line/strip, 2 = target reticle, 3 = team ring.
// progress 0..1 fills the shape as the cast charges, so you can read *where* and *when* it lands.
shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled;
uniform int mode = 0;
uniform float progress = 0.0;
uniform vec4 edge : source_color = vec4(1.0, 0.5, 0.4, 1.0);
uniform vec4 fill : source_color = vec4(1.0, 0.6, 0.3, 1.0);
uniform float strength = 1.0;
uniform float t = 0.0;
uniform float aspect = 1.0; // length / width for lines (dash spacing)
void fragment(){
	vec2 p = UV * 2.0 - 1.0;
	float a = 0.0; vec3 col = edge.rgb;
	if (mode == 0) {
		float r = length(p);
		if (r > 1.0) discard;
		float ang = atan(p.y, p.x);
		float rim = smoothstep(0.90, 0.955, r) * (1.0 - smoothstep(0.975, 1.0, r));
		float dash = step(0.5, fract(ang * 5.0 / 3.14159 + t * 0.35));
		float inner = smoothstep(0.80, 0.86, r) * (1.0 - smoothstep(0.86, 0.885, r)) * dash;
		float filled = 1.0 - smoothstep(progress - 0.02, progress, r);
		float front = smoothstep(progress - 0.07, progress - 0.01, r) * filled;
		a = rim * 0.95 + inner * 0.5 + filled * 0.20 + front * 0.55;
		col = mix(fill.rgb, edge.rgb, clamp(rim + front * 0.5, 0.0, 1.0));
	} else if (mode == 1) {
		float x = abs(p.x); float y = UV.y;
		float side = smoothstep(0.86, 0.93, x) * (1.0 - smoothstep(0.96, 1.0, x));
		float filled = 1.0 - smoothstep(progress - 0.015, progress, y);
		float chev = step(0.72, fract(y * aspect * 0.6 - x * 0.35 - t * 1.2)) * (1.0 - smoothstep(0.55, 0.8, x));
		float cap = smoothstep(0.96, 0.985, y);
		a = side * 0.95 + filled * 0.22 + chev * 0.28 + cap * 0.8;
		col = mix(fill.rgb, edge.rgb, clamp(side + cap, 0.0, 1.0));
	} else if (mode == 2) {
		float r = length(p);
		if (r > 1.0) discard;
		float ring = smoothstep(0.78, 0.85, r) * (1.0 - smoothstep(0.93, 1.0, r));
		float ang = atan(p.y, p.x) + t * 1.4;
		float ticks = step(0.82, abs(cos(ang * 2.0))) * smoothstep(0.35, 0.45, r) * (1.0 - smoothstep(0.62, 0.7, r));
		float dot_ = 1.0 - smoothstep(0.08, 0.13, r);
		a = (ring * 0.9 + ticks * 0.9 + dot_ * 0.7) * (0.55 + 0.45 * progress);
	} else {
		float r = length(p);
		if (r > 1.0) discard;
		float ring = smoothstep(0.80, 0.88, r) * (1.0 - smoothstep(0.94, 1.0, r));
		float glow = smoothstep(0.55, 0.9, r) * (1.0 - smoothstep(0.9, 1.0, r)) * 0.25;
		a = ring * 0.8 + glow;
	}
	ALBEDO = col;
	ALPHA = clamp(a * strength * edge.a, 0.0, 1.0);
}
␀␀␀// Soft additive glow sprite (flashes, motes, orbs). Always faces the camera.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
uniform float age = 0.0;
uniform float life = 1.0;
uniform vec4 tint : source_color = vec4(1.0);
uniform float intensity = 2.0;
uniform float hardness = 2.0;
uniform int mode = 0; // 0 flash (swell+fade), 1 steady, 2 star
void vertex(){
	vec3 c = MODEL_MATRIX[3].xyz; float s = length(MODEL_MATRIX[0].xyz);
	vec3 p = c + (INV_VIEW_MATRIX[0].xyz*VERTEX.x + INV_VIEW_MATRIX[1].xyz*VERTEX.y)*s;
	POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(p,1.0);
}
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	vec2 p = UV*2.0-1.0; float d = length(p);
	float g = pow(max(0.0, 1.0-d), hardness);
	if(mode==2){ g += 0.8*pow(max(0.0,1.0-abs(p.x)*10.0),2.0)*(1.0-abs(p.y)) + 0.8*pow(max(0.0,1.0-abs(p.y)*10.0),2.0)*(1.0-abs(p.x)); }
	float a = (mode==1) ? 1.0 : (1.0 - t)*(1.0 - t);
	if(mode==0) a *= smoothstep(0.0, 0.08, t);
	ALBEDO = tint.rgb*intensity;
	ALPHA = clamp(g*a*tint.a, 0.0, 1.0);
}
␀␀␀␀␀␀// Overlay pass on every fighter mesh: a bright rim-weighted flash when struck or casting.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_back;
uniform vec4 tint : source_color = vec4(1.0);
uniform float flash = 0.0;
void fragment(){
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.0);
	ALBEDO = tint.rgb * flash * (0.45 + 1.6 * rim);
}
␀␀␀␀shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age=0.0;
uniform float life=4.0;
uniform vec4 tint : source_color=vec4(1.,.3,.05,1.);
void fragment(){
 vec2 p=UV*2.-1.;float r=length(p);vec2 cells=vfx_voronoi(p*4.+vec2(age*.12,-age*.08));
 float cracks=1.-smoothstep(.02,.1,cells.y-cells.x);
 float heat=.7+.3*sin(age*5.+r*9.);
 vec3 molten=mix(tint.rgb,vec3(1.,.75,.15),cracks);
 ALBEDO=mix(vec3(.06,.025,.015),molten,cracks*.9);
 EMISSION=molten*cracks*heat*1.5;
 ALPHA=(1.-smoothstep(.82,1.,r))*smoothstep(0.,.16,age)*(1.-smoothstep(life-.6,life,age));
}
␀␀␀␀␀␀␀␀␀␀␀␀␀// A soft beam of light falling from the cave ceiling: brightest at the top, fading to nothing.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, shadows_disabled;
uniform vec4 tint : source_color = vec4(1.0, 0.9, 0.7, 1.0);
uniform float strength = 0.35;
void fragment(){
	float fall = pow(1.0 - UV.y, 1.6);
	float side = pow(1.0 - abs(dot(NORMAL, VIEW)), 1.5);
	float flicker = 0.85 + 0.15 * sin(TIME * 0.7 + UV.x * 6.0);
	ALBEDO = tint.rgb * fall * (1.0 - side) * strength * flicker;
}
␀␀// Low, slowly drifting ground mist for dungeon chambers. Thin enough to keep fighters' feet readable.
shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled, shadows_disabled;
uniform vec4 tint : source_color = vec4(0.6, 0.7, 0.8, 1.0);
uniform float density = 0.22;
uniform float speed = 0.015;
float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p){ vec2 i = floor(p); vec2 f = fract(p); f = f*f*(3.0-2.0*f);
	return mix(mix(hash(i), hash(i+vec2(1,0)), f.x), mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), f.x), f.y); }
float fbm(vec2 p){ float v = 0.0; float a = 0.5; for (int i = 0; i < 4; i++){ v += a*noise(p); p *= 2.03; a *= 0.5; } return v; }
void fragment(){
	vec2 uv = UV * 5.0;
	float n = fbm(uv + vec2(TIME*speed*7.0, TIME*speed*3.0)) * fbm(uv*0.6 - vec2(TIME*speed*4.0, 0.0));
	// Thicker toward the cave walls, almost clear in the middle of the fight.
	float edge = smoothstep(0.18, 0.5, length(UV - vec2(0.5)));
	ALBEDO = tint.rgb;
	ALPHA = clamp(n * 1.8, 0.0, 1.0) * density * (0.25 + 0.75*edge);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀// Dungeon monster skin: recolours the creature towards its tint and adds a soft rim glow.
// Drawn as a pass after the creature's own material, so its textures and animation stay intact.
shader_type spatial;
render_mode unshaded, blend_mul, depth_draw_never, cull_back;
uniform vec4 tint : source_color = vec4(1.0);
uniform float strength = 0.5;
uniform vec4 rim : source_color = vec4(1.0);
uniform float rim_amount = 0.3;
void fragment(){
	float edge = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.5);
	// Multiply by a colour above 1 at the rim so the edge brightens towards the glow colour.
	vec3 body = mix(vec3(1.0), tint.rgb * 1.35, strength);
	ALBEDO = body + rim.rgb * edge * rim_amount;
}
␀␀// Solid Meshy prop (banner, root claw): lit, grows up out of the ground, glowing rim, sinks/dissolves out.
shader_type spatial;
render_mode cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.6;
uniform vec4 base : source_color = vec4(0.35,0.25,0.18,1.0);
uniform vec4 tint : source_color = vec4(0.6,1.0,0.4,1.0);
uniform float rise = 0.25;   // fraction of life spent rising
uniform float height = 1.0;  // mesh height in local units
uniform float seed = 0.0;
varying vec3 lp;
void vertex(){
	lp = VERTEX;
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float up = smoothstep(0.0, rise, t);
	float down = smoothstep(0.82, 1.0, t);
	VERTEX.y -= height*(1.0-up)*1.05 + height*down*0.6;
}
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float n = vfx_fbm(lp.xz*5.0 + lp.y*3.0 + seed);
	float burn = smoothstep(0.7, 1.0, t);
	if(n < burn) discard;
	float edge = 1.0 - smoothstep(0.0, 0.08, n - burn);
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 3.0);
	ALBEDO = base.rgb*(0.75 + 0.5*n);
	ROUGHNESS = 0.85;
	EMISSION = tint.rgb*(fres*0.9 + edge*3.0 + 0.08);
}
␀␀␀␀// Ghostly Meshy prop: additive fresnel shell with flowing inner energy; fades and dissolves by age.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_back;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.4;
uniform vec4 tint : source_color = vec4(0.6,0.4,1.0,1.0);
uniform vec4 hot : source_color = vec4(1.0,0.9,1.0,1.0);
uniform float intensity = 1.3;
uniform float seed = 0.0;
varying vec3 lp;
void vertex(){ lp = VERTEX; }
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 2.2);
	float n = vfx_fbm(lp.xy*6.0 + vec2(0.0, -age*1.8) + seed);
	float appear = smoothstep(0.0, 0.18, t);
	float dissolve = smoothstep(n - 0.1, n + 0.1, 1.0 - smoothstep(0.55, 1.0, t)*1.2);
	vec3 col = mix(tint.rgb, hot.rgb, fres*0.6);
	ALBEDO = col*intensity;
	ALPHA = clamp((fres*0.85 + 0.18 + n*0.25)*appear*dissolve*tint.a, 0.0, 1.0);
}
␀␀␀␀␀␀␀// Stone chunk with procedural strata, optional molten glow in cracks (meteors, lava, magma).
shader_type spatial;
render_mode cull_back;
#include "res://shaders/vfx/common.gdshaderinc"
uniform vec4 stone : source_color = vec4(0.42,0.38,0.34,1.0);
uniform vec4 glow_color : source_color = vec4(1.0,0.45,0.1,1.0);
uniform float molten = 0.0;
uniform float seed = 0.0;
varying vec3 lp;
void vertex(){ lp = VERTEX; }
void fragment(){
	float n = vfx_fbm(lp.xz*3.0 + lp.y*2.0 + seed);
	float strata = vfx_noise(vec2(lp.y*9.0 + n*2.0, seed));
	vec2 v = vfx_voronoi(lp.xy*3.5 + lp.z*2.0 + seed);
	float crack = 1.0 - smoothstep(0.0, 0.06, v.y - v.x);
	ALBEDO = stone.rgb*(0.65 + 0.5*n)*(0.85+0.3*strata)*(1.0 - crack*0.5*(1.0-molten));
	ROUGHNESS = 0.9;
	EMISSION = glow_color.rgb*crack*molten*3.0;
}
␀␀␀␀␀␀// Ground rune circle / shockwave / crack decal on a horizontal quad. mode selects the pattern.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.2;
uniform vec4 tint : source_color = vec4(1.0,0.8,0.4,1.0);
uniform float intensity = 1.8;
uniform int mode = 0; // 0 rune circle, 1 shockwave ring, 2 ground cracks, 3 soft pool, 4 scorch
uniform float seed = 0.0;
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	vec2 p = UV*2.0-1.0; float r = length(p); float ang = atan(p.y, p.x);
	float a = 0.0;
	if(mode==0){
		float spinv = age*0.6;
		float ring1 = 1.0 - smoothstep(0.0, 0.025, abs(r-0.92));
		float ring2 = 1.0 - smoothstep(0.0, 0.018, abs(r-0.74));
		float ring3 = 1.0 - smoothstep(0.0, 0.012, abs(r-0.40));
		float ticks = (1.0 - smoothstep(0.0, 0.18, abs(fract((ang+spinv)*72.0/6.2831)-0.5)*2.0 - 0.0)) * step(0.80,r)*step(r,0.88);
		float glyph = step(0.62, vfx_noise(vec2(floor((ang-spinv)*18.0/6.2831)*3.1, floor(r*14.0)+seed)))*step(0.44,r)*step(r,0.72);
		float star = 1.0 - smoothstep(0.0, 0.02, abs(sin(3.0*(ang+spinv*-1.5))*r*0.9 - p.y*0.0 - r*0.0 + (r-0.66)));
		float draw = smoothstep(0.0, 0.3, t);
		a = (ring1 + ring2*0.75 + ring3*0.5 + ticks*0.45 + glyph*0.3) * draw * 0.75;
		a *= step(ang/6.2831+0.5, draw*1.2);
		a *= 1.0 - smoothstep(0.7, 1.0, t);
		a += (1.0 - smoothstep(0.0,1.0,r))*0.18*(1.0-t);
	} else if(mode==1){
		float front = t*1.0;
		float w = 0.06 + 0.1*t;
		a = (1.0 - smoothstep(0.0, w, abs(r - front))) * (1.0 - t);
		a += (1.0 - smoothstep(0.0, front, r))*0.25*(1.0-t)*step(r,front);
	} else if(mode==2){
		vec2 v = vfx_voronoi(p*4.0 + seed*3.0);
		float crack = 1.0 - smoothstep(0.0, 0.07, v.y - v.x);
		float reach = 1.0 - smoothstep(t*1.6, t*1.6+0.15, r);
		a = crack * reach * (1.0 - smoothstep(0.55, 1.0, t)) * (1.0 - smoothstep(0.7, 1.0, r));
		a += (1.0 - smoothstep(0.0, 0.5, r))*0.3*(1.0-t);
	} else if(mode==3){
		float n = vfx_fbm(p*3.0 + vec2(age*0.3, -age*0.2) + seed);
		a = (1.0 - smoothstep(0.55, 1.0, r + (n-0.5)*0.4)) * (0.45 + 0.55*n);
		a *= smoothstep(0.0, 0.15, t) * (1.0 - smoothstep(0.75, 1.0, t));
	} else {
		float n = vfx_fbm(p*4.0 + seed);
		a = (1.0 - smoothstep(0.3, 1.0, r + (n-0.5)*0.5)) * (1.0 - t) * 0.8;
	}
	ALBEDO = tint.rgb*min(intensity, 1.25);
	if(intensity > 1.25) a *= min(intensity/1.25, 1.3);
	ALPHA = clamp(a*tint.a, 0.0, 1.0);
}
␀// Protective bubble: fresnel rim, hex lattice, impact ripple sweep.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_back;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.2;
uniform vec4 tint : source_color = vec4(0.5,0.95,0.9,1.0);
uniform float intensity = 1.6;
uniform float hold = 0.0; // 1 keeps it visible (persistent shields)
float hexgrid(vec2 p){
	p.x *= 1.1547; p.y += mod(floor(p.x),2.0)*0.5;
	vec2 f = abs(fract(p)-0.5);
	return abs(max(f.x*1.5+f.y, f.y*2.0)-1.0);
}
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float fres = pow(1.0 - clamp(dot(NORMAL, VIEW),0.0,1.0), 2.2);
	float hex = 1.0 - smoothstep(0.0, 0.08, hexgrid(UV*vec2(18.0, 9.0)));
	float sweep = 1.0 - smoothstep(0.0, 0.12, abs(UV.y - fract(age*0.8)));
	float appear = smoothstep(0.0, 0.25, t);
	float fade = mix(1.0 - smoothstep(0.6,1.0,t), 1.0, hold);
	float a = (fres*0.9 + hex*0.35*(0.4+fres) + sweep*0.25) * appear * fade;
	ALBEDO = mix(tint.rgb, vec3(1.0), fres*0.5)*intensity;
	ALPHA = clamp(a, 0.0, 1.0);
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
uniform float age=0.0;
uniform float life=1.8;
uniform vec4 tint : source_color=vec4(.7,.4,1.,1.);
void fragment(){
 vec2 p=UV*2.-1.;float r=length(p);float a=atan(p.y,p.x);
 float reveal=smoothstep(0.,.22,age);float fade=1.-smoothstep(life*.65,life,age);
 float spokes=1.-smoothstep(.015,.045,abs(sin(a*8.))*r);
 float rings=1.-smoothstep(.018,.05,abs(fract(r*5.)-.5));
 float edge=1.-smoothstep(.86,1.,r);
 ALBEDO=tint.rgb;EMISSION=tint.rgb*.8;
 ALPHA=clamp((spokes+rings*.8)*edge*reveal*fade*.65,0.,.8);
}
␀␀␀␀␀␀␀␀␀␀␀␀// Soft billowing puff (alpha blended). Used for dust, poison clouds, shadow smoke, steam, frost mist.
shader_type spatial;
render_mode unshaded, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.5;
uniform vec4 tint : source_color = vec4(0.6,0.55,0.5,0.6);
uniform float seed = 0.0;
uniform float glow = 0.0;
void vertex(){
	vec3 c = MODEL_MATRIX[3].xyz; float s = length(MODEL_MATRIX[0].xyz);
	float t = clamp(age/max(life,0.001),0.0,1.0);
	s *= 0.6 + 0.8*sqrt(t);
	float rot = seed*6.28 + age*0.4;
	vec2 v = mat2(vec2(cos(rot),-sin(rot)), vec2(sin(rot),cos(rot))) * VERTEX.xy;
	vec3 p = c + (INV_VIEW_MATRIX[0].xyz*v.x + INV_VIEW_MATRIX[1].xyz*v.y)*s;
	POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(p,1.0);
}
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	vec2 p = UV*2.0-1.0;
	float n = vfx_fbm(p*1.8 + vec2(seed*5.0, age*0.35));
	float d = length(p) + (n-0.5)*0.7;
	float puff = 1.0 - smoothstep(0.35, 0.95, d);
	float alive = smoothstep(0.0, 0.18, t) * (1.0 - smoothstep(0.35, 1.0, t));
	vec3 col = tint.rgb*(0.75 + 0.5*n);
	ALBEDO = col; EMISSION = col*glow;
	ALPHA = clamp(puff*alive*tint.a*(0.6+0.6*n), 0.0, 1.0);
}
␀␀␀␀␀␀// Instanced particle spray (MultiMesh). INSTANCE_CUSTOM = (velocity.xyz, lifetime). COLOR per instance.
// Motion is analytic in age, so pausing/slow-motion only need the age uniform.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float gravity = 0.0;
uniform float drag = 0.8;
uniform float size_curve = 0.0; // 0 shrink, 1 grow-then-shrink, 2 constant
uniform int motif = 0; // 0 glow dot, 1 ember/streak, 2 feather, 3 leaf, 4 snow, 5 droplet, 6 shard, 7 star, 8 petal
uniform float stretch = 0.0;
uniform float intensity = 2.0;
uniform float spin = 3.0;
varying float v_t;
varying float v_seed;
void vertex(){
	vec3 vel = INSTANCE_CUSTOM.xyz; float lifetime = max(INSTANCE_CUSTOM.w, 0.01);
	float a = min(age, lifetime*1.5);
	v_t = clamp(age/lifetime, 0.0, 1.0);
	v_seed = fract(dot(vel, vec3(12.9898,78.233,45.164)));
	float k = drag;
	float travel = (k > 0.001) ? (1.0 - exp(-k*a))/k : a;
	vec3 anchor = MODEL_MATRIX[3].xyz + vel*travel + vec3(0.0, -0.5*gravity*a*a, 0.0);
	if(motif==2||motif==3||motif==8){ anchor.x += sin(a*3.0 + v_seed*20.0)*0.25*a; anchor.z += cos(a*2.3 + v_seed*13.0)*0.25*a; }
	float s = length(MODEL_MATRIX[0].xyz);
	if(size_curve < 0.5) s *= 1.0 - v_t*0.85;
	else if(size_curve < 1.5) s *= sin(min(v_t,1.0)*3.14159)*1.2 + 0.05;
	vec3 right = INV_VIEW_MATRIX[0].xyz; vec3 up = INV_VIEW_MATRIX[1].xyz;
	vec2 v = VERTEX.xy;
	if(stretch > 0.0){
		vec3 cur_vel = vel*exp(-k*a) + vec3(0.0,-gravity*a,0.0);
		vec3 dirv = normalize(cur_vel + vec3(0.0001));
		vec3 cam_dir = normalize(anchor - CAMERA_POSITION_WORLD);
		vec3 side = normalize(cross(dirv, cam_dir));
		right = side; up = dirv; v.y *= 1.0 + stretch*length(cur_vel);
	} else {
		float r = v_seed*6.28 + a*spin*(v_seed-0.5);
		v = mat2(vec2(cos(r),-sin(r)), vec2(sin(r),cos(r))) * v;
	}
	vec3 p = anchor + (right*v.x + up*v.y)*s;
	if(age > lifetime) p = vec3(0.0, -1000.0, 0.0);
	POSITION = PROJECTION_MATRIX * VIEW_MATRIX * vec4(p, 1.0);
}
void fragment(){
	vec2 p = UV*2.0-1.0; float d = length(p); float shape;
	if(motif==1){ shape = pow(max(0.0,1.0-length(vec2(p.x*2.2, p.y))),1.6); }
	else if(motif==2){ float spine = 1.0-smoothstep(0.0,0.08,abs(p.x)); float vane = 1.0-smoothstep(0.35,0.95,length(vec2(p.x*1.9,p.y))); shape = max(vane*(0.55+0.45*sin(p.y*30.0+abs(p.x)*18.0)), spine*step(abs(p.y),0.95)); }
	else if(motif==3){ shape = (1.0-smoothstep(0.6,1.0,length(vec2(p.x*1.9,p.y*0.95))))*(0.7+0.3*cos(abs(p.x)*18.0-p.y*6.0)); }
	else if(motif==4){ float a6 = abs(cos(atan(p.y,p.x)*3.0)); shape = (1.0-smoothstep(0.0,0.12,abs(d*(0.6+0.4*a6)-0.0) - 0.0))*0.0 + pow(max(0.0,1.0-d),2.0) + 0.7*(1.0-smoothstep(0.03,0.09,abs(sin(atan(p.y,p.x)*3.0))*d))*(1.0-smoothstep(0.7,1.0,d)); }
	else if(motif==5){ shape = 1.0-smoothstep(0.5,0.95,length(vec2(p.x*1.5,(p.y+0.2)*(p.y>0.0?0.7:1.2)))); }
	else if(motif==6){ shape = 1.0-smoothstep(0.55,0.75,abs(p.x)*1.4+abs(p.y)*0.8+0.25*abs(p.x+p.y)); }
	else if(motif==7){ shape = pow(max(0.0,1.0-d),3.0) + 0.9*pow(max(0.0,1.0-abs(p.x)*9.0),2.0)*(1.0-abs(p.y)) + 0.9*pow(max(0.0,1.0-abs(p.y)*9.0),2.0)*(1.0-abs(p.x)); }
	else if(motif==8){ shape = 1.0-smoothstep(0.5,1.0,length(vec2(p.x*1.4,p.y*1.0 - 0.3*p.x*p.x))); }
	else { shape = pow(max(0.0,1.0-d),2.2); }
	float fade = 1.0 - smoothstep(0.6, 1.0, v_t);
	ALBEDO = COLOR.rgb*intensity;
	ALPHA = clamp(shape*fade*COLOR.a, 0.0, 1.0);
}
␀␀␀␀␀␀// Tornado / vortex / water spiral surface on an open cone. Vertex twist + scrolling streak noise.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.5;
uniform vec4 tint : source_color = vec4(0.8,0.9,1.0,1.0);
uniform vec4 tint2 : source_color = vec4(1.0,1.0,1.0,1.0);
uniform float intensity = 0.95;
uniform float spin = 6.0;
uniform float twist = 2.5;
uniform float density = 1.0;
uniform float seed = 0.0;
void vertex(){
	float h = UV.y; // 0 bottom 1 top
	float ang = twist*h + age*spin*0.35;
	float wob = sin(age*3.0 + h*4.0 + seed)*0.08*h;
	float c = cos(ang), s = sin(ang);
	VERTEX.xz = mat2(vec2(c,-s), vec2(s,c)) * VERTEX.xz;
	VERTEX.x += wob;
}
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	vec2 uv = vec2(UV.x*3.0 - age*spin*0.18, UV.y*1.5 - age*0.6);
	float n = vfx_fbm(uv*vec2(4.0, 2.0) + seed);
	float streak = smoothstep(0.45, 0.85, vfx_fbm(vec2(UV.x*9.0 - age*spin*0.3 + UV.y*2.0, UV.y*1.2 + seed)));
	float band = smoothstep(0.0, 0.18, UV.y) * (1.0 - smoothstep(0.75, 1.0, UV.y));
	float alive = smoothstep(0.0, 0.15, t) * (1.0 - smoothstep(0.7, 1.0, t));
	float wisps = smoothstep(0.35,0.9,n);
	float a = (streak*0.75 + wisps*0.25) * band * alive * density * 0.8;
	vec3 col = mix(tint.rgb, tint2.rgb, streak);
	ALBEDO = col*intensity;
	ALPHA = clamp(a, 0.0, 1.0);
}
␀␀␀␀// Vines, roots and thorns: bark gradient with an emissive growth tip; grows along UV.y.
shader_type spatial;
render_mode cull_disabled;
#include "res://shaders/vfx/common.gdshaderinc"
uniform float age = 0.0;
uniform float life = 1.8;
uniform vec4 bark : source_color = vec4(0.25,0.35,0.15,1.0);
uniform vec4 glow_color : source_color = vec4(0.6,1.0,0.4,1.0);
uniform float grow_time = 0.35;
void fragment(){
	float t = clamp(age/max(life,0.001),0.0,1.0);
	float grown = smoothstep(0.0, grow_time, t);
	float wither = smoothstep(0.8, 1.0, t);
	if(UV.y > grown*(1.0 - wither)) discard;
	float n = vfx_fbm(vec2(UV.x*8.0, UV.y*20.0));
	ALBEDO = bark.rgb*(0.6+0.7*n);
	ROUGHNESS = 0.85;
	float tip = 1.0 - smoothstep(0.0, 0.15, grown - UV.y);
	EMISSION = glow_color.rgb*(tip*1.8 + 0.15*n);
}
