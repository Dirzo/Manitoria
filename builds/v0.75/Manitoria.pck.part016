    "species": "minotaur"
  },
  {
    "description": "Rally allies: +22% attack and speed for 4s, with a small shield.",
    "effect": "rally",
    "hero": "Minotaur",
    "index": 1,
    "name": "Blood of the Labyrinth",
    "species": "minotaur"
  },
  {
    "description": "Spin through nearby foes for 200% attack and gain a shield.",
    "effect": "whirl",
    "hero": "Minotaur",
    "index": 2,
    "name": "Minotaur Cyclone",
    "species": "minotaur"
  },
  {
    "description": "Shield allies in range for 22% of your maximum health for 5s.",
    "effect": "ward",
    "hero": "Minotaur",
    "index": 3,
    "name": "Minotaur Aegis",
    "species": "minotaur"
  },
  {
    "description": "Strike a wounded foe for 170% attack; heal for damage dealt.",
    "effect": "drain",
