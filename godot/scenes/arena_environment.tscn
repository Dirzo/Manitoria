[sub_resource type="Shader" id="Shader_6ygba"]
code = "shader_type spatial; render_mode cull_disabled; uniform vec4 color : source_color = vec4(0.1,0.3,0.4,1.0); void vertex(){float weight=(VERTEX.z+1.3)/2.6; VERTEX.y+=sin(TIME*1.8+VERTEX.x*2.7+VERTEX.z*2.0)*0.16*weight; VERTEX.x+=sin(TIME*1.4+VERTEX.z*2.1)*0.04*weight;} void fragment(){float stripe=1.0-step(0.045,abs(UV.x-0.5)); ALBEDO=mix(color.rgb,vec3(0.66,0.48,0.25),stripe); ROUGHNESS=0.95;}"

